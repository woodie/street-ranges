{
  "name": "street-ranges",
  "private": true,
  "type": "module",
  "description": "The lookup page (TypeScript, built by Vite) and its lint and test tasks",
  "scripts": {
    "build": "vite build",
    "test": "vitest run --reporter=tree",
    "lint": "eslint --fix . && tsc --noEmit && html-validate public/",
    "check": "eslint . && tsc --noEmit && html-validate public/ && vitest run --coverage --reporter=dot && vite build && git diff --exit-code public/main.js",
    "test-js": "vitest run --coverage",
    "civic": "vitest run --config vitest.civic.config.js"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "html-validate": "^11.5.6",
    "jsdom": "^30.1.2",
    "neostandard": "^0.14.0",
    "penultimate": "^0.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  }
}
